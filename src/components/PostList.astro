---
import type {CollectionEntry} from 'astro:content';
import {postUrl,formatDate} from '../lib/posts';
interface Props { posts: CollectionEntry<'posts'>[] }
const {posts}=Astro.props;
---
{posts.map(post=><a class="post" href={postUrl(post)}><div class="post-meta"><time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time><span>{post.data.tags[0] || '学习笔记'}</span></div><div><div class="tags">{post.data.tags.slice(1,3).join(' / ')}</div><h3>{post.data.title}{post.data.draft && <small>（草稿）</small>}<span>↗</span></h3><p>{post.data.description}</p><span class="read">阅读这篇文章 <b>→</b></span></div></a>)}
{posts.length === 0 && <p class="empty">还没有发布的文章。</p>}
