---
import '../styles/global.css';
interface Props {title: string; description?: string; article?: boolean; date?: Date;}
const {title, description='h4j11n 的技术实践、比赛复盘与学习记录。',article=false,date}=Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html><html lang="zh-CN"><head><meta charset="UTF-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>{title} · h4j11n</title><meta name="description" content={description}/><link rel="canonical" href={canonical}/>
<meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:url" content={canonical}/><meta property="og:type" content={article?'article':'website'}/><meta property="og:locale" content="zh_CN"/><meta property="og:site_name" content="h4j11n"/>
{date && <meta property="article:published_time" content={date.toISOString()}/>}
<meta name="twitter:card" content="summary"/><link rel="icon" href="/favicon.svg"/><link rel="alternate" type="application/rss+xml" title="h4j11n" href="/atom.xml"/>
<script is:inline>try{document.documentElement.dataset.theme=localStorage.getItem('blog-theme')||'light'}catch{}</script>
</head><body id="top"><a class="skip" href="#main">跳转到正文</a><div class="site">
<header class="header"><a class="brand" href="/">h4j11n<span class="dot">.</span></a><nav aria-label="主导航"><a href="/#writing">文章</a><a href="/archives/">归档</a><a href="/#about">关于</a><button id="theme" aria-label="切换深浅主题">◐</button></nav></header>
<slot/>
<footer><a class="brand" href="/">h4j11n<span class="dot">.</span></a><a href="/atom.xml">RSS</a><a href="https://github.com/h4j11n" target="_blank" rel="noopener">GitHub ↗</a><a href="#top">回到顶部 ↑</a></footer></div>
<script>document.querySelector('#theme')?.addEventListener('click',()=>{const root=document.documentElement;root.dataset.theme=root.dataset.theme==='dark'?'light':'dark';try{localStorage.setItem('blog-theme',root.dataset.theme)}catch{}});</script>
</body></html>
