---
import Base from '../../layouts/Base.astro';import PostList from '../../components/PostList.astro';import {publishedPosts} from '../../lib/posts';
export async function getStaticPaths(){const posts=await publishedPosts();return [...new Set(posts.flatMap(p=>p.data.tags))].map(tag=>({params:{tag},props:{tag,posts:posts.filter(p=>p.data.tags.includes(tag))}}));}
const {tag,posts}=Astro.props;
---
<Base title={tag}><main id="main" class="listing"><div class="back"><a href="/archives/">← 全部文章</a></div><h1>{tag}</h1><PostList posts={posts}/></main></Base>
